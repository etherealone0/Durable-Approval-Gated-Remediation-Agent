# LLM — first one set wins: Anthropic, then OpenAI, then local Ollama,
# else the rule-based heuristic fallback in src/eval/runner.py
ANTHROPIC_API_KEY=
OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=

# Durable checkpointer (AsyncPostgresSaver) and mock "production" database
DATABASE_URL=postgresql://interlock:interlock@localhost:5432/interlock

# Sandbox mock services (docker-compose)
SERVICE_A_URL=http://localhost:8001
SERVICE_B_URL=http://localhost:8002
SERVICE_C_URL=http://localhost:8003

# FastAPI runtime
API_HOST=0.0.0.0
API_PORT=8000

# Approval UI
NEXT_PUBLIC_API_URL=http://localhost:8000
